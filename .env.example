# Newsletter Automation - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# INDUSTRY CONFIGURATION
# ============================================

# Industry name (e.g., Technology, Finance, Healthcare)
INDUSTRY_NAME=Technology

# Keywords for news API searches (comma-separated)
INDUSTRY_KEYWORDS=AI, machine learning, software development, cloud computing

# Newsletter title that appears in emails
NEWSLETTER_TITLE=Daily Tech Digest

# Your company/organization name
COMPANY_NAME=Your Company Name

# ============================================
# NEWS SOURCES
# ============================================

# RSS Feeds (comma-separated URLs)
RSS_FEEDS=https://feeds.feedburner.com/TechCrunch/,https://www.theverge.com/rss/index.xml

# NewsAPI Key (get yours at https://newsapi.org)
NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# EMAIL CONFIGURATION
# ============================================

# Recipients (comma-separated email addresses)
EMAIL_RECIPIENTS=team@company.com,newsletter@company.com

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=newsletter@yourcompany.com
SMTP_FROM_NAME=Newsletter Bot

# ============================================
# TELEGRAM CONFIGURATION
# ============================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID for the channel/group to send to
# Use @userinfobot or similar to get your chat ID
TELEGRAM_CHAT_ID=-1001234567890

# ============================================
# SCHEDULE CONFIGURATION
# ============================================

# Hour to send newsletter (24-hour format, UTC)
SCHEDULE_HOUR=7

# Minute to send newsletter
SCHEDULE_MINUTE=0

# Timezone (e.g., America/New_York, Europe/London)
TIMEZONE=UTC
